# config.sh.example -- copy to config.sh and edit.  config.sh is gitignored.
#
#   cp config.sh.example config.sh && $EDITOR config.sh && sh tools/check-env.sh
#
# Every script in this repository sources config.sh from the repository root.
#
# HOW THIS FILE IS ARRANGED.  Everything the build needs lives under one directory, and the
# mandatory settings are derived from it -- so in the ordinary case you change AMIX_BUILD and
# nothing else.  Each line can still be pointed somewhere else individually; the layout is a
# suggestion, not a requirement.
#
# What the scripts guarantee is the failure mode, not the paths: a wrong path stops the build
# with a message naming the variable, rather than failing somewhere deep in a linker.
# `sh tools/check-env.sh` tells you which ones are wrong before you build anything.
#
# See BUILDING.md for what each dependency is and where to get it.

# One directory holding everything below.  Anywhere you like.
AMIX_BUILD="$HOME/amix-build"

# ---------------------------------------------------------------- MANDATORY, to build a kernel

# 1. The AMIX cross toolchain: m68k-cbm-sysv4-gcc / -ld.
#    This is the compiler that produces SVR4 m68k objects the AMIX linker accepts, and the one
#    thing here you have to build yourself, from the gcc-cross-amix tree.  AMIX_CROSS is where
#    you installed it; GCC_CROSS_ENV is the env.sh inside its build tree, which puts it on PATH
#    with the right sysroot.
AMIX_CROSS="$AMIX_BUILD/cross"
GCC_CROSS_ENV="$AMIX_BUILD/gcc-cross-amix/build/env.sh"

# 2. GNU m68k binutils: m68k-linux-gnu-{nm,objcopy,objdump,readelf,size,gcc}.
#    Used for symbol surgery, relocation inspection and the ELF checks.  A distribution package
#    (Debian/Ubuntu: binutils-m68k-linux-gnu, gcc-m68k-linux-gnu) is fine, and then this is
#    already right.
M68K_GNU_BIN="/usr/bin"

# 3. Your own AMIX installation, mounted or unpacked read-only.
#    The port is a patch layer over the kernel binary in it.  The one file that must be present:
#        $AMIX_ROOT/stand/unix        sha256 7d26cb6f04991be5776d9e5361259b20b413d97e3da33bf88e6f312e7be2ec23
#    (AMIX SVR4 2.1c.  A different build is REFUSED by tools/verify-stock.sh before anything is
#    patched, because the patch offsets would land on the wrong bytes -- see BUILDING.md.)
AMIX_ROOT="$AMIX_BUILD/amix-2.1c"

# 4. NetBSD source tarball, for Motorola's 68040/68060 support packages and the FPE.
#    The FPSP, the ISP and the floating-point emulator are extracted from
#    sys/arch/m68k/{fpsp,060sp,fpe} inside it; they are NOT vendored in this repository.
#
#    PIN THIS EXACTLY.  It is not "any recent release": the extraction is part of the build, so
#    the tarball is a build input like any source file, and two releases do not produce the same
#    kernel.  All four scripts that extract from it -- build-fpsp040.sh, build-fpsp060.sh,
#    build-ftest060.sh and src/extract_fpe.sh -- refuse anything else.  The sha256 they check
#    against lives in tools/netbsd-pin.sh, which is where the pin moves when it moves; the copy
#    below is documentation, so that this file can say which release to fetch.
#
#    NetBSD 10.1 syssrc.tgz, 79497697 bytes,
#    from https://cdn.netbsd.org/pub/NetBSD/NetBSD-10.1/source/sets/syssrc.tgz
#    sha256 76a600e703d2e964753323e264d3ec07d0c6cbe134648fc8f0f13ed9faaa1be4
#    sha512 766ac21f33cfe0e701dfedb894fa07f36d811da1a12e979181e8fca7af4e627852680ce42a7b29e97dd3e2e402ddf9ae7bfba60c8d7dc6b8a3354d8ce8c06926
NETBSD_SYSSRC="$AMIX_BUILD/syssrc-10.1.tgz"

# ---------------------------------------------------------------- OPTIONAL: emulator testing
#
# The rest of this file points at other people's projects and at your own files, so there is no
# sensible shared layout for them.  Fill in the ones you want; leave the others alone.

# Amiberry, for booting the kernel without hardware.  A LOCAL BUILD is needed: the packaged
# 8.2.2 cannot deliver host->guest network frames, which the test cycle relies on.
AMIBERRY_BIN="/path/to/amiberry/build/amiberry"
AMIBERRY_CONF="$HOME/Amiberry/Configurations"     # Amiberry's own default
AMIBERRY_HDF="/path/to/your/hardfiles"

# ---------------------------------------------------------------- OPTIONAL: graphics kernels

# Xsvga driver object (Klaus Burckert's Piccolo / Picasso II server-side blob), needed only by
# relink-040-xsvga.sh and relink-040-rtg.sh.
XSVGA_EXP="/path/to/svga/exp"

# MNT VA2000 driver source, needed only by relink-040-va2000.sh and relink-040-rtg.sh.
# Its own repository: va2000-amix.  Point at the .c file itself; the .h beside it is used too.
VA2000_SRC="/path/to/va2000-amix/src/va2000.c"

# Z3660 driver sources, needed only by relink-040-z3660.sh.  Separate upstream repositories:
# amix-z3660scsi and amix-z3660net.
Z3660_SCSI_SRC="/path/to/amix-z3660scsi/src/z3660.c"
Z3660_NET_SRC="/path/to/amix-z3660net/src"

# ---------------------------------------------------------------- OPTIONAL: analysis

# Ghidra, for the decompilation helper in tools/.  Not needed to build anything.
GHIDRA_HOME="/path/to/ghidra"
