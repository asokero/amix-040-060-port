# secrets.env.example -- copy to local/secrets.env and fill in.
#
# local/secrets.env is gitignored and MUST NOT be committed.  The test tooling reads it;
# nothing in the published repository contains a credential.
#
#   cp local/secrets.env.example local/secrets.env && $EDITOR local/secrets.env

# The AMIX machine used for hardware runs.
AMIX_HOST=10.0.0.1
AMIX_USER=root
AMIX_PASS=changeme

# Emulator (Amiberry) telnet endpoint.
EMU_HOST=localhost
EMU_PORT=2323

# TFTP server port used to move binaries onto the machine.  Pick one that is free:
#   ss -uln | grep <port>
TFTP_PORT=1069
